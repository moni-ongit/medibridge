# ==========================================
# MediBridge Server Environment Variables
# Copy this file to .env and fill in real values.
# Nothing in this file is a real secret.
# ==========================================

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/medibridge

# JWT
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# ------------------------------------------
# OPTIONAL: Real Speech-to-Text / Translation providers.
# If left blank, the app automatically falls back to the
# built-in MOCK translation + speech services (see
# server/services/translationService.js and speechService.js)
# so the whole platform works with zero paid API keys.
# ------------------------------------------

# Set to "mock" or "google" (or extend services yourself)
TRANSLATION_PROVIDER=mock
SPEECH_PROVIDER=mock

# Google Cloud Translation / Speech-to-Text (optional)
GOOGLE_TRANSLATE_API_KEY=
GOOGLE_SPEECH_API_KEY=

# ------------------------------------------
# OPTIONAL: Video calling provider.
# Set to "mock" for a demo-friendly local WebRTC/peer-to-peer
# stub, or "livekit" to use a real LiveKit deployment.
# ------------------------------------------
VIDEO_PROVIDER=mock
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

# ------------------------------------------
# Consultation join window
# A video consultation can only be joined around its booked time:
#   opens  JOIN_EARLY_MINUTES before the start time
#   closes JOIN_CLOSE_AFTER_MINUTES after the start time (late joins only;
#          people already in the call are not disconnected)
# Appointment date/time are treated as clinic-local time using this UTC
# offset in minutes (330 = India Standard Time, UTC+5:30).
# ------------------------------------------
JOIN_EARLY_MINUTES=5
JOIN_CLOSE_AFTER_MINUTES=45
APPOINTMENT_UTC_OFFSET_MINUTES=330
