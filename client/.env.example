# Copy this file to .env and adjust if your backend runs elsewhere.
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

# "mock" enables the built-in demo video call UI with no external
# video provider required. Set to "livekit" once LIVEKIT_URL etc.
# are configured on the backend and you've wired up the LiveKit SDK.
VITE_VIDEO_PROVIDER=mock
